akapiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: socket-app-gitops
  namespace: argocd
spec:
  project: default
  source:
    repoURL: 'https://github.com/aziz-mevlana/kubernetes-03-production-ready-RKE2-HA-cluster'
    path: socket-chart  # Chart veya manifestlerin bulunduğu klasör yolu
    targetRevision: HEAD
  destination:
    server: 'https://kubernetes.default.svc'
    namespace: socket-app  # Uygulamanın deploy edileceği hedef namespace
  syncPolicy:
    automated:  
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true  # Eksik namespace'leri otomatik oluşturur
